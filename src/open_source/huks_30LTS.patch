+int32_t HksCheckValue(uint32_t inputValue, const uint32_t *expectValues, uint32_t valuesCount)
+{
+    for (uint32_t i = 0; i < valuesCount; ++i) {
+        if (inputValue == expectValues[i]) {
+            return HKS_SUCCESS;
+        }
+    }
+    return HKS_ERROR_INVALID_ARGUMENT;
+}
