+    if ((keyMaterial->pubKeySize > HKS_DH_KEY_SIZE_4096) || (keyMaterial->priKeySize > HKS_DH_KEY_SIZE_4096)) {
+        HKS_LOG_E("invalid import key material pubKey/priKey size, bigger than 4096");
