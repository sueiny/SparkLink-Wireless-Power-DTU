+    uint8_t pubKey[HKS_RSA_KEY_SIZE_1024] = {0};
+    struct HksBlob publicKey = { HKS_RSA_KEY_SIZE_1024, pubKey };
+    ret = HksExportPublicKey(&keyAlias, genParamSet, &publicKey);
