+    ASSERT_TRUE(ret == HKS_ERROR_NULL_POINTER);
+}
+
+/**
+ * @tc.name: HksCoreServiceTest.HksCoreServiceTest004
+ * @tc.desc: tdd HksCoreFinish, expect ret == HKS_ERROR_INSUFFICIENT_MEMORY
