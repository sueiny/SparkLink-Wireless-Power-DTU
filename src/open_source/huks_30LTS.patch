+
+        ret = HksGetKeyAliasByProcessName(processInfo, keyInfoList, listCount);
+        HKS_IF_NOT_SUCC_LOGE_BREAK(ret, "get key alias list from storage failed, ret = %" LOG_PUBLIC "d", ret)
+
+        for (uint32_t i = 0; i < *listCount; ++i) {
