+    ret = HksUpdate(&handle, initParamSet, publicKey, &outDataUpdate);
+    EXPECT_EQ(ret, HKS_SUCCESS) << "Update failed.";
+    if (ret != HKS_SUCCESS) {
+        return HKS_FAILURE;
+    }
+
+    ret = HksAbort(&handle, initParamSet);
