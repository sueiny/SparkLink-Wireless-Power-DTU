+    HksDeleteKey(&baseKeyAlias1, NULL);
+    HksDeleteKey(&baseKeyAlias2, NULL);
+    HksDeleteKey(&pubKeyAlias1, NULL);
+    HksDeleteKey(&pubKeyAlias2, NULL);
+    HksDeleteKey(&aesKeyAlias1, NULL);
