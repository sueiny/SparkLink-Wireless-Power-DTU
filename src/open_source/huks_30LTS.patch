+static bool CheckProcessNameTagExist(const struct HksParamSet *paramSet)
+{
+    for (uint32_t i = 0; i < paramSet->paramsCnt; ++i) {
+        if (paramSet->params[i].tag == HKS_TAG_PROCESS_NAME) {
+            return true;
+        }
+    }
+
+    return false;
+}
