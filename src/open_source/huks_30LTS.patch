+        { .tag = HKS_TAG_KEY_GENERATE_TYPE, .uint32Param = HKS_KEY_GENERATE_TYPE_DEFAULT },
+    },
+    .hexData = "0123456789abcdef",
+    .generateKeyResult = HKS_SUCCESS,
+    .hmacResult = HKS_SUCCESS,
+};
