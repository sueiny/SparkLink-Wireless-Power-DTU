+static struct HksBlob g_storageImageBuffer;
+
+static int32_t GetKeyOffsetByKeyAlias(const struct HksBlob *keyAlias, uint32_t *keyOffset)
+{
+    struct HksBlob storageBuf = g_storageImageBuffer;
