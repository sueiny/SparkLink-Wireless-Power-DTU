-        }
-    }
-
-    if (ret != HKS_SUCCESS) {
-        for (uint32_t j = 0; j < i; ++j) {
-            HKS_FREE_BLOB(keyInfoList[j].alias);
-            HKS_FREE_PTR(keyInfoList[j].paramSet);
-        }
-    }
-    return ret;
