-            return HKS_ERROR_MALLOC_FAIL;
-        }
-        (void)memset_s((*blob)->data, realBlobDataSize, 0, realBlobDataSize);
-        uint32_t offset = 0;
-        for (uint32_t i = 0; i < (realBlobDataSize - 1) / HKS_TEST_1024; i++) {
