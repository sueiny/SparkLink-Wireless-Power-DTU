+    if ((keyMaterial->pubKeySize > HKS_CURVE25519_KEY_SIZE_256) ||
+        (keyMaterial->priKeySize > HKS_CURVE25519_KEY_SIZE_256)) {
+        HKS_LOG_E("invalid import key material pubKey/priKey size, bigger than 256");
