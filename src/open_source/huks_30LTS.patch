+static struct HksBlob g_rootKeyMaterialFile[] = {
+    { HKS_ROOT_MATERIAL_FILE_NAME_LEN, (uint8_t *)HKS_ROOT_MATERIAL_FILE_NAME },
+    { HKS_ROOT_MATERIAL_FILE_NAME_LEN, (uint8_t *)HKS_BAK_ROOT_MATERIAL_FILE_NAME },
