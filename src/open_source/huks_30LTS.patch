+        return HKS_ERROR_MALLOC_FAIL;
+    }
+    sizeRead = HksFileRead(g_storePath, (char *)keyAliasTwo->data, 0, bufTwo, sizeOne);
+    int32_t ret = memcmp(bufOne, bufTwo, sizeOne);
+    HksTestFree(bufOne);
+    HksTestFree(bufTwo);
+    return ret;
+}
