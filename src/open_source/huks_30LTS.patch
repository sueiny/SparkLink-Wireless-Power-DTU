+    OH_HUKS_TAG_ATTESTATION_ID_VERSION_INFO = OH_HUKS_TAG_TYPE_BYTES | 515,
+
+    /**
+     * 601 to 1000 are reserved for other tags.
+     *
+     * Extended tags. The value range is 1001 to 9999.
