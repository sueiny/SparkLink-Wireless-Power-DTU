+        if (plainText != NULL) {
+            (void)memset_s(plainText->data, oriPlainTextSize, 0, oriPlainTextSize);
+            plainText->size = oriPlainTextSize;
+        }
+        ret = HksDecrypt(key, paramSet, cipherText, plainText);
+        if (ret != HKS_SUCCESS) {
+            break;
+        }
+    }
+    return ret;
+}
