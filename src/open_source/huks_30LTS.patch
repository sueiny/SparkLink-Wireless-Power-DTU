+    ret = HksAddParams(*newParamSet, signParams, 1);
+    if (ret != HKS_SUCCESS) {
+        HKS_LOG_E("HksAddParam failed!\n");
+        return ret;
+    }
+    ret = HksBuildParamSet(newParamSet);
+    if (ret != HKS_SUCCESS) {
+        HKS_LOG_E("HksBuildParamSet failed!\n");
+        return ret;
+    }
+    return ret;
