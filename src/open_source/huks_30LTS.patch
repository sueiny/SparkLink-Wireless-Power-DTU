+    ASSERT_TRUE(ret != HKS_SUCCESS);
+    FreeCertChain(&certChain, certChain->certsCount);
+    certChain = NULL;
+
+    HksFreeParamSet(&paramSet);
+
+    ret = HksDeleteKey(&g_keyAlias, NULL);
+    ASSERT_TRUE(ret == HKS_SUCCESS);
+}
