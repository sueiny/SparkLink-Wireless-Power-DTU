+#define HKS_ROOT_MATERIAL_FILE_NAME "info1.data"
+#define HKS_BAK_ROOT_MATERIAL_FILE_NAME "info2.data"
+#define HKS_ROOT_MATERIAL_FILE_NAME_LEN 10
