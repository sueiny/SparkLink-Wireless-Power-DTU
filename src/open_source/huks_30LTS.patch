-static int32_t GetNewFormatKey(const struct HksBlob *keyInfo, struct HksBlob *key)
-{
-    struct HksBlob kek = { 0, NULL };
-    struct HksBlob nonce = { 0, NULL };
-    struct HksBlob rawKey = { 0, NULL };
-    int32_t ret = GetNonce(keyInfo, &nonce);
