+            return EVP_aes_128_cbc();
+        case HKS_KEY_BYTES(HKS_AES_KEY_SIZE_192):
+            return EVP_aes_192_cbc();
+        case HKS_KEY_BYTES(HKS_AES_KEY_SIZE_256):
