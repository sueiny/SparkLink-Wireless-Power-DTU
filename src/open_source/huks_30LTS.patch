+    material.priKeySize = key->privateOrYData.size;
+    material.reserved = 0;
+
+    uint32_t size = sizeof(material) + material.pubKeySize + material.priKeySize;
+    uint8_t *data = (uint8_t *)HksMalloc(size);
+    if (data == nullptr) {
+        return HKS_ERROR_MALLOC_FAIL;
