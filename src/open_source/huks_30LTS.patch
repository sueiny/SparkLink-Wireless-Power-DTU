+static int32_t TestGenerateKeyParamSetPre(struct GenerateKeyParamSetStructure *paramStruct,
+    struct HksParamSet *paramSet)
+{
+    if (!paramStruct->paramSetExist) {
+        return 0; // do nothing, return null
+    }
+    int32_t ret = 1;
+
+    if (paramStruct->setAlg) {
