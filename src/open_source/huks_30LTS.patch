+#endif
+#ifdef _USE_MBEDTLS_
+    ASSERT_EQ(ret, HKS_ERROR_NOT_SUPPORTED);
+#endif
+    HKS_FREE_BLOB(key);
+    HKS_FREE_BLOB(keyOut);
