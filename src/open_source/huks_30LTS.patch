+        EXPECT_EQ(HksExportPublicKey(&testAlias, nullptr, &publicKey), HKS_SUCCESS);
+    }
+    EXPECT_EQ(HksDeleteKey(&authId, nullptr), HKS_SUCCESS);
+    HksFree(publicKey.data);
+}
