-        }
-        if ((*keyInfoList)[i].paramSet != NULL) {
-            HksFree((*keyInfoList)[i].paramSet);
-            (*keyInfoList)[i].paramSet = NULL;
-        }
-    }
-
-    HKS_FREE_PTR(*keyInfoList);
-}
