+static int32_t DhGetNid(uint32_t keySize, int *nid)
+{
+    switch (keySize) {
+        case HKS_DH_KEY_SIZE_2048:
+            *nid = NID_ffdhe2048;
+            return DH_SUCCESS;
+        case HKS_DH_KEY_SIZE_3072:
+            *nid = NID_ffdhe3072;
+            return DH_SUCCESS;
+        case HKS_DH_KEY_SIZE_4096:
+            *nid = NID_ffdhe4096;
+            return DH_SUCCESS;
+        default:
+            return DH_FAILED;
+    }
+}
