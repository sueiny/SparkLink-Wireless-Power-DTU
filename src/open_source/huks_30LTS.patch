+    ret = ConstructDataToCertChain(&certChain, &certParam);
+    ASSERT_TRUE(ret == HKS_SUCCESS);
+    ret = HksAttestKey(&g_keyAlias, paramSet, certChain);
+
+    ASSERT_TRUE(ret == HKS_ERROR_NO_PERMISSION);
