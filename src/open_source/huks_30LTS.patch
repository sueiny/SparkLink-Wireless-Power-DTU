+                    .mode = HKS_MODE_GCM,
+                    .padding = HKS_PADDING_NONE,
+                    .digest = HKS_DIGEST_NONE,
+                    .purpose = HKS_KEY_PURPOSE_ENCRYPT | HKS_KEY_PURPOSE_DECRYPT,
+                    .algParam = &aeadParamForGcm,
+                };
+                EXPECT_EQ(
