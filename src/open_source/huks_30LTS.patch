+    result = ImportWrappedKeyAsyncWork(env, context);
+    if (result == nullptr) {
+        HKS_LOG_E("could not start async work");
+        DeleteImportWrappedKeyAsyncContext(env, context);
+        return nullptr;
+    }
+    return result;
+}
+}  // namespace HuksNapiItem
diff -Naru huks/interfaces/kits/napi/src/v9/huks_napi_init_session.cpp huks_new/interfaces/kits/napi/src/v9/huks_napi_init_session.cpp
--- huks/interfaces/kits/napi/src/v9/huks_napi_init_session.cpp	1970-01-01 08:00:00.000000000 +0800
+++ huks_new/interfaces/kits/napi/src/v9/huks_napi_init_session.cpp	2025-02-12 15:01:29.014543500 +0800
@@ -0,0 +1,207 @@
+/*
