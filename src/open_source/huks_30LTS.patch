+struct HksHitraceId HksHitraceBegin(const char *name, int flag)
+{
+#ifdef L2_STANDARD
+    HiTraceIdStruct traceId = HiTraceChainBegin(name, flag);
+    struct HksHitraceId hitraceId = {
+        .traceId = traceId,
+    };
