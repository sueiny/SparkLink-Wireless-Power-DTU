-    /* check keyOut */
-    if (keyOut->size < (sizeof(struct KeyMaterial25519) + keyMaterial->pubKeySize)) {
-        HKS_LOG_E("X25519 public keyOut size too small! keyOut size = 0x%X", keyOut->size);
