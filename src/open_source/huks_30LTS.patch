-    }
-    if (infoSize != 0) {
-        HKS_TEST_ASSERT(TestConstuctBlob(infoData, true, infoSize, true, infoSize) == 0);
-    }
-    struct TestDeriveParamSetStructure paramStruct = {
-        &deriveParamSet,
