-    if (ret != HKS_SUCCESS) {
-        HKS_LOG_E("get blobSize failed");
-        return ret;
-    }
-
-    if (IsInvalidLength(blobSize)) {
-        HKS_LOG_E("get blobSize failed");
-        return HKS_ERROR_INVALID_ARGUMENT;
-    }
-
-    uint8_t *blobData = (uint8_t *)HksMalloc(blobSize);
-    if (blobData == NULL) {
-        return HKS_ERROR_MALLOC_FAIL;
-    }
-
-    blob->data = blobData;
-    blob->size = blobSize;
-    return HKS_SUCCESS;
