+            }
+            EXPECT_EQ(message.size, plaintext.size);
+            EXPECT_EQ(HksMemCmp(message.data, plaintext.data, plaintext.size), HKS_SUCCESS);
+        }
+
+        HksFree(key.data);
+        HksFree(cipherText.data);
+        HksFree(plaintext.data);
+        HksFree(tagAead.data);
+    }
