+            EXPECT_EQ(HksMemCmp(plainText.data, plainTextDecrypt.data, testCaseParams.hexData.length()), 0);
+            HksFree(plainTextDecrypt.data);
+        }
+
+        (void)HksDeleteKey(&authId, nullptr);
+        HksFree(cipherText.data);
+        HksFreeParamSet(&paramInSet);
+    }
+};
