+static int32_t CompareKeyData(struct HksBlob *keyAliasOne, struct HksBlob *keyAliasTwo)
+{
+    uint32_t sizeOne = HksTestFileSize(g_storePath, "hks_keystore");
+    if (sizeOne == 0) {
