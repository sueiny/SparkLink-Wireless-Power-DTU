-static void FreeKeyInfo(uint32_t listCount, struct HksKeyInfo **keyInfoList)
-{
-    if ((keyInfoList == NULL) || (*keyInfoList == NULL)) {
-        return;
-    }
-
-    for (uint32_t i = 0; i < listCount; ++i) {
-        if ((*keyInfoList)[i].alias.data != NULL) {
