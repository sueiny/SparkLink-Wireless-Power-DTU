+     * @syscap SystemCapability.Security.Huks
+     * @since 8
+     * @deprecated since 9
+     */
+    HUKS_TAG_OS_VERSION = HuksTagType.HUKS_TAG_TYPE_UINT | 10101,
+    /**
+     * @syscap SystemCapability.Security.Huks
+     * @since 8
+     * @deprecated since 9
+     */
+    HUKS_TAG_OS_PATCHLEVEL = HuksTagType.HUKS_TAG_TYPE_UINT | 10102,
