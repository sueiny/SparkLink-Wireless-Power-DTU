+uint8_t HksCryptoHalCommon::HexChar(char hex) const
+{
+    if (hex >= '0' && hex <= '9') {
+        return hex - '0';
+    } else if (hex >= 'A' && hex <= 'F') {
+        return hex - 'A' + 0X0A;
+    } else if (hex >= 'a' && hex <= 'f') {
+        return hex - 'a' + 0X0A;
+    } else {
+        return 0;
+    }
+}
