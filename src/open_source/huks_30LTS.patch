+#include HKS_CONFIG_FILE
+#else
+#include "hks_config.h"
+#endif
+
+#include "hks_secure_access.h"
+
+#include "hks_base_check.h"
+#include "hks_keyblob.h"
+#include "hks_keynode.h"
+#include "hks_log.h"
+#include "hks_mem.h"
