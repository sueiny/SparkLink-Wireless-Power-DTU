+void ParamForDSASign(struct HksParamSet *paramInSet)
+{
+    HksAddParams(paramInSet, &g_PARAM_PADDING_PKCS1_V1_5, 1);
+    HksAddParams(paramInSet, &g_PARAM_KEYSIZE_DSA_1024, 1);
+    const struct HksParam *paramDigest[] = {
